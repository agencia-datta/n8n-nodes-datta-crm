{
	"name": "n8n-nodes-datta-crm",
	"version": "0.3.0",
	"description": "n8n nodes for Datta CRM: leads, sales, forms, email drafts and real-time triggers.",
	"license": "MIT",
	"homepage": "https://github.com/agencia-datta/n8n-nodes-datta-crm#readme",
	"keywords": [
		"n8n-community-node-package",
		"n8n",
		"datta-crm",
		"crm"
	],
	"author": {
		"name": "Agência Datta",
		"email": "contato@agenciadatta.com.br"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/agencia-datta/n8n-nodes-datta-crm.git"
	},
	"scripts": {
		"build": "n8n-node build",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"test": "vitest run",
		"release": "n8n-node release",
		"prepublishOnly": "n8n-node prerelease"
	},
	"files": [
		"dist",
		"!dist/tsconfig.tsbuildinfo"
	],
	"publishConfig": {
		"access": "public",
		"provenance": true
	},
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": true,
		"credentials": [
			"dist/credentials/DattaCrmApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/DattaCrm/DattaCrm.node.js",
			"dist/nodes/DattaCrmTrigger/DattaCrmTrigger.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "0.53.2",
		"eslint": "9.32.0",
		"n8n-workflow": "2.16.0",
		"prettier": "3.6.2",
		"release-it": "^21.1.0",
		"typescript": "5.9.2",
		"vitest": "5.0.5"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	}
}
